PORT=3000

# Usados a partir do passo 3 (login) e 6 (upload Cloudinary) — ainda não usados nos passos 1-2
SESSION_SECRET=troque-este-valor
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
